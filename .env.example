# 访问口令。留空或不设置 = 开放模式（无登录页，API 免鉴权）
# Docker / 公网部署请务必设置，例如：AUTH_TOKEN=changeme
AUTH_TOKEN=
SESSION_SECRET=dev-change-me
DATA_DIR=./data
DOWNLOAD_DIR=./downloads
HOST=0.0.0.0
PORT=18980
# 飞牛网关部署时构建/运行使用，例如 /app/miyin/
# NUXT_APP_BASE_URL=/app/miyin/
# GATEWAY_PREFIX=/app/miyin/
# SOCKET_PATH=/tmp/miyin.sock
